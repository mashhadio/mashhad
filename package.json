{
  "name": "mashhad",
  "productName": "مشهد",
  "version": "0.1.0",
  "description": "مشهد — مسجّل شاشة مع تكبير سلس يتتبّع المؤشر وتنقية لضوضاء الميكروفون",
  "main": "src/main/main.js",
  "author": "Abdul",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "node scripts/make-icons.js",
    "logo": "node scripts/make-logo.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "fontkit": "^2.0.4",
    "png-to-ico": "^3.0.1",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "ffmpeg-static": "^5.2.0",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.abdul.mashhad",
    "productName": "مشهد",
    "executableName": "Mashhad",
    "artifactName": "Mashhad-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "مشهد"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "synopsis": "مسجّل شاشة مع تكبير ذكي يتتبّع المؤشر",
      "executableName": "Mashhad",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "يستخدم «مشهد» الكاميرا لعرض الكاميرا الاختياري.",
        "NSMicrophoneUsageDescription": "يسجّل «مشهد» الميكروفون للتعليق الصوتي.",
        "NSScreenCaptureUsageDescription": "يسجّل «مشهد» شاشتك."
      }
    },
    "dmg": {
      "title": "مشهد"
    }
  }
}
